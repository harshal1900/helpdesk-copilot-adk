# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is listed in .gitignore. Never commit real keys.

# --- Gemini API (Google AI Studio) -----------------------------------------
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
# 0 = use the Gemini API key above. 1 = use Vertex AI / Google Cloud instead
# (then also set GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION and sign in
# with Application Default Credentials).
GOOGLE_GENAI_USE_ENTERPRISE=0
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Model names -------------------------------------------------------------
# Model IDs and free-tier access change often. Check the current list in
# AI Studio and your project's rate limits before you run. If you get a 404
# or a "limit: 0" 429 error, change the model name here, no code change needed.
TRIAGE_MODEL=gemini-3.5-flash
DRAFT_MODEL=gemini-3.5-flash
JUDGE_MODEL=gemini-3.5-flash
# Models used only by the evaluation scripts (optional, they default to the values
# above). Quota is counted per model, so a different model here keeps the evals
# from using up the quota of the app's models.
# EVAL_JUDGE_MODEL=gemini-3.8-flash   # judge inside scripts/run_evals.py
# ROUTING_MODEL=gemini-3.5-flash      # scripts/measure_routing.py
# Total attempts per call when Google returns a temporary error (503 high demand,
# 429 rate limit). Waits grow between attempts.
LLM_RETRY_ATTEMPTS=5

# --- Retrieval ---------------------------------------------------------------
# gemini = Gemini embeddings (needs the API key). local = offline hashing
# embeddings, lexical only, for tests and for trying retrieval with no key.
EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL=gemini-embedding-001
TOP_K=4

# --- Guardrail thresholds (tune on your own labelled tickets) ----------------
# Minimum similarity of the best retrieved passage. Scores depend on the
# embedding backend, so re-tune this if you change EMBEDDING_BACKEND.
MIN_RETRIEVAL_SCORE=0.45
# Triage confidence below this value escalates the ticket to a human.
MIN_TRIAGE_CONFIDENCE=0.70

# --- Optional audit trail ----------------------------------------------------
# If set, every run writes a JSON audit file into this folder.
# Tickets can contain personal data: protect or purge this folder accordingly.
# AUDIT_DIR=audit
